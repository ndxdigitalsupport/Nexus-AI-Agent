      <tr>
        <td><b>claude-sonnet-5 & claude-fable-5</b></td>
        <td>14 requests</td>
        <td><b>~3,850,000 Quota</b></td>
        <td><b style="color: #dc2626;">54.8% of spent budget</b></td>
      </tr>
      <tr>
        <td><b>deepseek-v4-flash</b></td>
        <td>45 requests</td>
        <td><b>~310,000 Quota</b></td>
        <td><b style="color: #16a34a;">4.4% of spent budget</b></td>
      </tr>
      <tr>
        <td><b>mimo-v2.5</b></td>
        <td>22 requests</td>
        <td><b>~180,000 Quota</b></td>
        <td><b style="color: #16a34a;">2.5% of spent budget</b></td>
      </tr>
    </tbody>
